APP_ENV=development
INTERNAL_API_TOKEN=replace-with-a-long-random-token
ADMIN_API_TOKEN=replace-with-a-different-long-random-admin-token
USER_HMAC_SECRET=replace-with-a-different-long-random-secret
PUBLIC_BASE_URL=http://127.0.0.1:8000
AI_BIND_ADDRESS=127.0.0.1
AI_IMAGE=jx-now-ai-management:0.2.1

# Dify PostgreSQL instance, but a separate database and role.  Never use the
# Dify application role/database here.
DATABASE_URL=postgresql+psycopg://ai_management:replace-with-a-long-random-password@db_postgres:5432/ai_management
# Dify Redis DB 5 only; every key must begin with ai:.  Do not run FLUSHALL.
REDIS_URL=redis://:replace-with-dify-redis-password@redis:6379/5

DIFY_BASE_URL=http://dify-api:5001/v1
DIFY_BUSINESS_APP_API_KEY=
DIFY_MOMENTS_APP_API_KEY=
DIFY_WRITING_APP_API_KEY=
DIFY_SUMMARY_PROFILE_APP_API_KEY=

DIFY_KNOWLEDGE_BASE_URL=http://dify-api:5001/v1
DIFY_KNOWLEDGE_API_KEY=
DIFY_GENERAL_DATASET_ID=
DIFY_COURSE_DATASET_ID=

# Dedicated Alibaba Model Studio credential. Never reuse a Dify-stored key.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLEANING_MODEL=qwen-plus
CLEANING_PROMPT_VERSION=commercial-cleaning-v1
# Bump only when persisted cleaning semantics change; matching source hashes
# from an older revision are re-cleaned instead of silently reused.
CLEANING_SPEC_REVISION=commercial-cleaning-v3
CLEANING_BATCH_CANDIDATE_THRESHOLD=100
CLEANING_BATCH_TOKEN_THRESHOLD=200000
CLEANING_BATCH_MAX_REQUESTS=40000
CLEANING_BATCH_MAX_BYTES=419430400
CLEANING_CANDIDATE_MAX_TOKENS=12000
# Dify hierarchical custom parent segment cap. Dify accepts only 50..4000;
# this is deliberately independent of CLEANING_CANDIDATE_MAX_TOKENS.
DIFY_PARENT_MAX_TOKENS=2000
# Conservative application-side starting caps; calibrate below the account quota.
CLEANING_REALTIME_RPM=60
CLEANING_REALTIME_TPM=500000
# Batch is opt-in because provider jobs may take hours to complete. Set true
# only for an explicitly approved production Batch run.
BAILIAN_BATCH_ENABLED=false
# Batch approval is blocked unless this price snapshot is complete and current.
CLEANING_PRICE_VERSION=
CLEANING_PRICE_EFFECTIVE_DATE=
CLEANING_PRICE_VALID_UNTIL=
CLEANING_INPUT_PRICE_PER_MILLION=0
CLEANING_OUTPUT_PRICE_PER_MILLION=0
# Realtime calls use a separate, non-discounted price snapshot.
CLEANING_REALTIME_PRICE_VERSION=
CLEANING_REALTIME_PRICE_EFFECTIVE_DATE=
CLEANING_REALTIME_PRICE_VALID_UNTIL=
CLEANING_REALTIME_INPUT_PRICE_PER_MILLION=0
CLEANING_REALTIME_OUTPUT_PRICE_PER_MILLION=0
# OCR is opt-in. The page limit applies only to scanned PDFs routed to
# PaddleOCR; text-layer PDFs use pdfplumber and are not limited by this value.
PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=10
PDF_OCR_TASK_TIMEOUT_SECONDS=600
PDF_OCR_RENDER_DPI=200
PDF_OCR_RETRY_DPI=300
PDF_OCR_AUTO_CONFIDENCE=0.90
PDF_OCR_MIN_CONFIDENCE=0.75
PDF_OCR_MAX_LOW_CONF_RATIO=0.10
PDF_OCR_CPU_THREADS=4
PDF_OCR_MODEL_ROOT=var/ocr-models
PDF_OCR_MODEL_MANIFEST=var/ocr-models/manifest.json
# Internal course-route upload-only automation.  A run is blocked when the
# price snapshot is invalid or its estimated upper bound exceeds this cap.
COURSE_CATALOG_AUTO_PUBLISH=true
COURSE_CATALOG_AUTO_APPROVE_COST_MAX=1.0
DIFY_PUBLISH_WINDOW_START_HOUR=0
# The commercial-advisor ingestion flow publishes approved documents all day.
DIFY_PUBLISH_WINDOW_END_HOUR=24
DIFY_SHARD_MAX_ITEMS=200
DIFY_SHARD_MAX_BYTES=1000000

HISTORY_RETENTION_DAYS=7
CLEANUP_HOUR=2
CLEANUP_MINUTE=0
SUMMARY_USER_TURNS=6
SUMMARY_APPROX_CHARS=6000
SUMMARY_BATCH_MAX_CHARS=40000
SUMMARY_BATCH_MAX_MESSAGES=100
CONTEXT_MAX_CHARS=24000
CONTEXT_MAX_MESSAGES=50
MAX_QUERY_CHARS=12000

MAX_UPLOAD_FILE_MB=200
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BATCH_MB=500
MAX_ACTIVE_CLEANING_BATCHES=5
CLEANING_WORKER_CONCURRENCY=4
# Test-only diagnostic artifact. false means do not write and remove leftovers
# on API startup/nightly maintenance. Never expose this directory through HTTP.
SAVE_CONVERSION_MARKDOWN=false
CONVERSION_MARKDOWN_ROOT=/app/var/conversion-markdown
CONVERSION_MARKDOWN_HOST_ROOT=./var/conversion-markdown
CONVERSION_MARKDOWN_RETENTION_DAYS=7
FAILED_FILE_RETENTION_HOURS=24
CLEANING_STATUS_RETENTION_DAYS=7
SYSTEM_LOG_RETENTION_DAYS=30
CLICK_COUNTER_RETENTION_DAYS=30
UPLOAD_ROOT=var/uploads
BUILD_VERSION=0.2.1
