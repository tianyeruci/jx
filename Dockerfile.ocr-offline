ARG AI_IMAGE=jx-now-ai-management:0.2.1
FROM ${AI_IMAGE}

USER root

# The OCR runtime is a deployment-controlled, offline bundle. It is generated
# on the target Debian/amd64 host and intentionally lives under var/, which is
# ignored by Git and never enters a source release archive.
COPY var/ocr-runtime/debs /opt/ocr-runtime/debs
COPY var/ocr-runtime/site-packages /usr/local/lib/python3.11/site-packages
COPY var/ocr-runtime/requirements-ocr.lock /opt/ocr-runtime/requirements-ocr.lock
COPY var/ocr-runtime/models /app/.paddlex/official_models
COPY scripts/ocr_worker_entrypoint.sh /app/scripts/ocr_worker_entrypoint.sh

RUN cp /opt/ocr-runtime/debs/*.deb /var/cache/apt/archives/ \
    && (dpkg -i /opt/ocr-runtime/debs/*.deb || apt-get -f install --no-download -y) \
    && python -m pip check \
    && python -c "import paddle, paddleocr, paddlex; print('offline OCR dependency closure imported')" \
    && chmod 0755 /app/scripts/ocr_worker_entrypoint.sh \
    && chown -R appuser:appuser /app/.paddlex /app/scripts/ocr_worker_entrypoint.sh \
    && rm -rf /opt/ocr-runtime /var/lib/apt/lists/*

ENV HOME=/app \
    PADDLE_PDX_MODEL_SOURCE=bos \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER appuser
ENTRYPOINT ["/app/scripts/ocr_worker_entrypoint.sh"]
