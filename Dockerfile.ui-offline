FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY wheelhouse /wheelhouse
COPY ui-wheelhouse-linux /ui-wheelhouse
RUN pip install --no-cache-dir --no-index \
    --find-links=/wheelhouse \
    --find-links=/ui-wheelhouse \
    "jx-now-ai-management[ui]==0.2.0" \
    && rm -rf /wheelhouse /ui-wheelhouse

EXPOSE 8501
CMD ["streamlit", "run", "ai_management/test_ui.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true"]
