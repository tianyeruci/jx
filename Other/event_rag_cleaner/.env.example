# ===== 基础目录 =====
EVENT_BASE_DIR=/opt/ai-management/tmp/活动
EVENT_TIMEZONE=Asia/Shanghai

# ===== 千问 / 阿里云百炼 =====
# 千问 / 阿里云百炼 API Key
BAILIAN_API_KEY=sk-xxxxxxxx
QWEN_MODEL=qwen3.7-plus

# 实时 Chat Completions
QWEN_REALTIME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=180

# Batch Chat：单请求同步排队端点，不等于 JSONL 异步批处理
QWEN_BATCH_CHAT_BASE_URL=https://batch.dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BATCH_TIMEOUT_SECONDS=1800

# Batch File：JSONL 上传 -> 异步任务 -> 下载结果
QWEN_BATCH_FILE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BATCH_COMPLETION_WINDOW=24h
QWEN_BATCH_POLL_SECONDS=10
QWEN_BATCH_MAX_WAIT_SECONDS=86400
# 单个 Batch 子任务失败时是否回退实时 API；建议 true，避免一条坏记录拖累整个批次
QWEN_BATCH_FALLBACK_REALTIME=true

# 稳定性控制
QWEN_MAX_RETRIES=3
QWEN_MAX_TOKENS=2500
# 严格 Schema 已保证结构；该参数仅用于“结构合法但业务语义校验失败”后的定向修复
QWEN_SEMANTIC_REPAIR_RETRIES=1

# ===== Dify Knowledge API（可选） =====
# 例如自托管: http://127.0.0.1/v1
DIFY_API_BASE=http://127.0.0.1/v1
DIFY_API_KEY=dataset-xxxxxxxx
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DIFY_TIMEOUT_SECONDS=60

# Dify 父子块配置
DIFY_PARENT_SEPARATOR=<<<DIFY_PARENT>>>
DIFY_CHILD_SEPARATOR=<<<DIFY_CHILD>>>
DIFY_PARENT_MAX_TOKENS=4000
DIFY_CHILD_MAX_TOKENS=800
